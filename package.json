{
  "name": "root-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "portfolio:dev": "bun run --elide-lines=0 --filter portfolio dev",
    "portfolio:build": "bun run --elide-lines=0 --filter portfolio build",
    "portfolio:preview": "bun run --elide-lines=0 --filter portfolio preview",
    "trading:dev": "bun run --elide-lines=0 --filter trading dev",
    "trading:build": "bun run --elide-lines=0 --filter trading build",
    "trading:preview": "bun run --elide-lines=0 --filter trading preview",
    "trading:test": "bun run --elide-lines=0 --filter trading test",
    "trading:convex": "bun run --elide-lines=0 --filter trading convex",
    "code:dev": "bun run --elide-lines=0 --filter code dev",
    "code:build": "bun run --elide-lines=0 --filter code build",
    "code:preview": "bun run --elide-lines=0 --filter code preview",
    "code:convex": "bun run --elide-lines=0 --filter code convex",
    "ui:add": "bun run --cwd packages/ui ui:add",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:typecheck": "oxlint --type-aware --type-check"
  },
  "devDependencies": {
    "oxfmt": "^0.50.0",
    "oxlint": "^1.65.0",
    "oxlint-tsgolint": "^0.22.1"
  }
}
