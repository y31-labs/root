---
import Layout from "../layouts/Layout.astro";
import PostTitleTransition from "../components/PostTitleTransition.astro";
import {
	formatPublishedDate,
	getPublishedPosts,
	getReadingTime,
} from "../lib/posts";
import { AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from "../lib/site";

const posts = await getPublishedPosts();
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<main class="page-shell home-page" id="main-content">
		<section class="intro" aria-labelledby="intro-title">
			<h1 id="intro-title">{AUTHOR.name}</h1>
			<nav class="intro-links" aria-label="Profile links">
				<a
					href={AUTHOR.github}
					data-profile-link="github"
					rel="me noreferrer"
					target="_blank"
				>
					GitHub
				</a>
				<a
					href={AUTHOR.linkedin}
					data-profile-link="linkedin"
					rel="me noreferrer"
					target="_blank"
				>
					LinkedIn
				</a>
			</nav>
		</section>

		<figure class="home-image">
			<img
				src="/images/opossum-trash.jpg"
				width="750"
				height="506"
				alt="Opossum meme reading: Don't you dare touch my trash."
				decoding="async"
				fetchpriority="high"
			/>
		</figure>

		<section class="writing-index" id="writing" aria-labelledby="writing-title">
			<header class="section-heading">
				<h2 id="writing-title">Writing</h2>
			</header>

			{
				posts.length > 0 ? (
					<ol class="post-list">
						{posts.map((post) => (
							<li>
								<article class="post-row">
									<a href={`/writing/${post.id}/`}>
										<div class="post-row-copy">
											<h3>
												<PostTitleTransition postId={post.id} title={post.data.title} />
											</h3>
											<p>{post.data.description}</p>
										</div>
										<p class="post-meta">
											<time datetime={post.data.publishedAt.toISOString()}>
												{formatPublishedDate(post.data.publishedAt)}
											</time>
											<span aria-hidden="true">&middot;</span>
											<span>{getReadingTime(post.body)} min read</span>
										</p>
									</a>
								</article>
							</li>
						))}
					</ol>
				) : (
					<p class="empty-state">
						No writing here yet. The first piece is still taking shape.
					</p>
				)
			}
		</section>
	</main>
</Layout>
