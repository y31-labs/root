---
import { render, type CollectionEntry } from "astro:content";
import PostTitleTransition from "../../components/PostTitleTransition.astro";
import Layout from "../../layouts/Layout.astro";
import {
	formatPublishedDate,
	getPublishedPosts,
	getReadingTime,
} from "../../lib/posts";
import { AUTHOR } from "../../lib/site";

interface Props {
	post: CollectionEntry<"writing">;
}

export async function getStaticPaths() {
	const posts = await getPublishedPosts();

	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const readingTime = getReadingTime(post.body);
const pageTitle = `${post.data.title} | ${AUTHOR.name}`;
const tableOfContents = headings.filter(
	({ depth }) => depth === 2 || depth === 3,
);
const hasTableOfContents = tableOfContents.length > 0;
---

<Layout
	title={pageTitle}
	description={post.data.description}
	canonical={`/writing/${post.id}/`}
	pageType="article"
	article={{
		headline: post.data.title,
		publishedAt: post.data.publishedAt,
		updatedAt: post.data.updatedAt,
	}}
>
	<header class="site-header">
		<a href="/">{AUTHOR.name}</a>
		<a href="/#writing">Writing</a>
	</header>

	<main
		class={`post-shell${hasTableOfContents ? " post-shell-with-toc" : ""}`}
		id="main-content"
	>
		<article
			data-post
			data-post-slug={post.id}
			data-post-title={post.data.title}
			data-reading-time={readingTime}
		>
			<header class="post-header">
				<p class="post-meta">
					<time datetime={post.data.publishedAt.toISOString()}>
						{formatPublishedDate(post.data.publishedAt)}
					</time>
					<span aria-hidden="true">&middot;</span>
					<span>{readingTime} min read</span>
				</p>
				<h1>
					<PostTitleTransition postId={post.id} title={post.data.title} />
				</h1>
				<p class="post-description">{post.data.description}</p>
			</header>

			{
				hasTableOfContents ? (
					<div class="post-body-with-toc">
						<aside class="post-toc" aria-labelledby="post-toc-title">
							<h2 id="post-toc-title">Table of contents</h2>
							<nav aria-label="Post sections">
								<ol>
									{tableOfContents.map((heading) => (
										<li class={`post-toc-level-${heading.depth}`}>
											<a
												href={`#${heading.slug}`}
												data-toc-link
												data-toc-slug={heading.slug}
											>
												{heading.text}
											</a>
										</li>
									))}
								</ol>
							</nav>
						</aside>

						<div class="prose">
							<Content />
						</div>
					</div>
				) : (
					<div class="prose">
						<Content />
					</div>
				)
			}
		</article>
	</main>

	<script>
		let cleanupPostToc: (() => void) | undefined;

		const setupPostToc = () => {
			cleanupPostToc?.();
			cleanupPostToc = undefined;

			const links = Array.from(
				document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
			);

			if (links.length === 0) return;

			const headings = links
				.map((link) => {
					const slug = link.dataset.tocSlug;

					return slug ? document.getElementById(slug) : null;
				})
				.filter((heading): heading is HTMLElement => heading instanceof HTMLElement);

			if (headings.length === 0) return;

			const setActiveLink = (activeId: string) => {
				for (const link of links) {
					if (link.dataset.tocSlug === activeId) {
						link.setAttribute("aria-current", "location");
					} else {
						link.removeAttribute("aria-current");
					}
				}
			};

			const updateActiveLink = () => {
				let activeHeading = headings[0];

				for (const heading of headings) {
					if (heading.getBoundingClientRect().top <= 128) {
						activeHeading = heading;
					} else {
						break;
					}
				}

				setActiveLink(activeHeading.id);
			};

			let animationFrame = 0;
			const requestActiveLinkUpdate = () => {
				if (animationFrame) return;

				animationFrame = window.requestAnimationFrame(() => {
					animationFrame = 0;
					updateActiveLink();
				});
			};

			window.addEventListener("scroll", requestActiveLinkUpdate, {
				passive: true,
			});
			window.addEventListener("resize", requestActiveLinkUpdate);
			updateActiveLink();

			cleanupPostToc = () => {
				if (animationFrame) {
					window.cancelAnimationFrame(animationFrame);
				}

				window.removeEventListener("scroll", requestActiveLinkUpdate);
				window.removeEventListener("resize", requestActiveLinkUpdate);
			};
		};

		document.addEventListener("astro:page-load", setupPostToc);
		setupPostToc();
	</script>
</Layout>
