---
import SectionHeading from './SectionHeading.astro';
import './Outcome.css';

const features = [
  {
    id: 'provider',
    title: 'Bring your Codex setup',
    copy: 'Use the Codex authentication already configured on your Mac. Austi keeps the connection in the trusted desktop host.',
  },
  {
    id: 'savings',
    title: 'Run it without another prompt',
    copy: 'Once the workflow is built, repeat work happens in its interface—no new model reasoning required.',
  },
  {
    id: 'ux',
    title: 'Give the work a real interface',
    copy: 'Chat is a narrow column. Your workflow gets the controls, views, and feedback it needs.',
  },
  {
    id: 'personal',
    title: 'Make the interface yours',
    copy: 'Give each app the density and visual character its work calls for instead of settling for one generic chat skin.',
  },
  {
    id: 'security',
    title: 'Keep authority narrow',
    copy: 'Apps start without network or credential access. You decide which specific capabilities they can use.',
  },
  {
    id: 'evolving',
    title: 'Change it without starting over',
    copy: 'Ask for a revision in plain language. Austi updates the app while preserving the work already inside it.',
  },
];
---

<section class="outcome paper-field" aria-labelledby="outcome-title">
  <SectionHeading
    id="outcome-title"
    title="Built to actually be useful"
    highlight="actually"
    layout="centered"
  />

  <div class="feature-grid">
    {features.map((feature) => (
      <article class:list={['feature-panel', `feature-panel-${feature.id}`]}>
        <h3 class="feature-label">{feature.title}</h3>
        <p>{feature.copy}</p>

        {feature.id === 'provider' && (
          <div class="feature-visual provider-picker" aria-hidden="true">
            <header><span>Codex connection</span><small><i></i>Ready</small></header>
            <dl>
              <div><dt>Authentication</dt><dd>Existing local session</dd></div>
              <div><dt>Runtime</dt><dd>Managed by Austi</dd></div>
              <div><dt>App access</dt><dd>None by default</dd></div>
            </dl>
            <footer>Connection stays in the desktop host</footer>
          </div>
        )}

        {feature.id === 'savings' && (
          <div class="feature-visual savings-meter" aria-hidden="true">
            <header><span>Weekly launch run</span><i></i></header>
            <strong>0</strong>
            <p>model turns per repeat run</p>
            <div><span>Monday</span><span>Tuesday</span><span>Wednesday</span><span>Today</span></div>
            <small>Runs in the app · No new model call</small>
          </div>
        )}

        {feature.id === 'ux' && (
          <div class="feature-visual app-preview" aria-hidden="true">
            <header><i></i><i></i><i></i><span>Launch planner</span></header>
            <div><aside><strong>This week</strong><span class="is-active">Launch plan</span><span>Decisions</span><span>Archive</span></aside><div class="app-preview-main"><strong>May 12–18</strong><span>Landing page <i>In progress</i></span><span>Email campaign <i>In progress</i></span><span>Launch video <i>Planned</i></span></div></div>
          </div>
        )}

        {feature.id === 'personal' && (
          <div class="feature-visual theme-preview" aria-hidden="true">
            <div class="theme-swatches"><span class="is-active">Paper</span><span>Night</span><span>Dense</span></div>
            <div class="theme-window"><header><span></span><small>Campaign tracker</small></header><strong>Make it yours.</strong><p>One workflow. Your density, type, and theme.</p><div><i></i><i></i><i></i></div></div>
          </div>
        )}

        {feature.id === 'security' && (
          <div class="feature-visual access-sheet" aria-hidden="true">
            <header><span>Launch planner access</span><small>1 capability</small></header>
            <div><span><i>F</i><strong>Local files</strong><small>Selected folder</small><b></b></span><span><i>N</i><strong>Network</strong><small>No access</small><b class="is-off"></b></span><span><i>K</i><strong>Credentials</strong><small>Never available</small><b class="is-off"></b></span></div>
            <footer><i></i>Controlled by you</footer>
          </div>
        )}

        {feature.id === 'evolving' && (
          <div class="feature-visual evolution-preview" aria-hidden="true">
            <div class="evolution-request">Add a calendar view. Keep my existing launch items.<i><svg viewBox="0 0 18 18"><path d="M9 14V4m0 0L5 8m4-4 4 4"></path></svg></i></div>
            <div class="evolution-line"><span><i></i>Revision 1</span><b></b><span class="is-current"><i></i>Revision 2<small>Calendar added · 6 items preserved</small></span></div>
          </div>
        )}
      </article>
    ))}
  </div>
</section>
