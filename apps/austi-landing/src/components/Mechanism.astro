---
import { stages } from '../lib/landing-content';
import MechanismEvidence from './MechanismEvidence.astro';
import SectionHeading from './SectionHeading.astro';
import './Mechanism.css';
---

<section class="mechanism paper-field" id="how-it-works" aria-labelledby="mechanism-title">
  <SectionHeading
    id="mechanism-title"
    title="The best platform to automate your routine"
    layout="centered"
  />

  <div class="mechanism-stage" id="mechanism-stage">
    <nav class="stage-controller" aria-label="Request to app stages">
      {stages.map((item, index) => (
        <a href={`#mechanism-step-${index + 1}`} data-stage-link={index} class:list={{ 'is-active': index === 0 }} aria-current={index === 0 ? 'step' : undefined}>
          <span class="stage-number">{String(index + 1).padStart(2, '0')} / {item.name}</span>
          <strong>{item.label}</strong>
          <small><span>{item.copy}</span></small>
        </a>
      ))}
    </nav>

    <div class="stage-feed">
      {stages.map((item, index) => (
        <article class="stage-panel" id={`mechanism-step-${index + 1}`} data-stage-panel={index}>
          <MechanismEvidence stage={index} />
          <div class="mobile-stage-copy">
            <span>{String(index + 1).padStart(2, '0')} / {item.name}</span>
            <h3>{item.label}</h3>
            <p>{item.copy}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-stage-link]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-stage-panel]')];
  let frame = 0;
  let navigationTarget: number | null = null;
  let navigationTimer = 0;

  const setActiveStage = (activeIndex: number) => {
    links.forEach((link, index) => {
      const active = index === activeIndex;
      link.classList.toggle('is-active', active);
      if (active) link.setAttribute('aria-current', 'step');
      else link.removeAttribute('aria-current');
    });
  };

  const updateActiveStage = () => {
    frame = 0;
    if (navigationTarget !== null) return;
    const marker = window.innerHeight * 0.38;
    let activeIndex = 0;

    panels.forEach((panel, index) => {
      if (panel.getBoundingClientRect().top <= marker) activeIndex = index;
    });

    setActiveStage(activeIndex);
  };

  const finishNavigation = () => {
    navigationTarget = null;
    updateActiveStage();
  };

  const queueNavigationEnd = () => {
    window.clearTimeout(navigationTimer);
    navigationTimer = window.setTimeout(finishNavigation, 180);
  };

  const queueActiveStageUpdate = () => {
    if (navigationTarget !== null) {
      queueNavigationEnd();
      return;
    }
    if (frame) return;
    frame = window.requestAnimationFrame(updateActiveStage);
  };

  links.forEach((link, index) => {
    link.addEventListener('click', () => {
      navigationTarget = index;
      setActiveStage(index);
      window.clearTimeout(navigationTimer);
      navigationTimer = window.setTimeout(finishNavigation, 300);
    });
  });

  window.addEventListener('scroll', queueActiveStageUpdate, { passive: true });
  window.addEventListener('resize', queueActiveStageUpdate);
  updateActiveStage();
</script>
