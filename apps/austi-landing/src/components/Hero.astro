---
import './Hero.css';
import { HeroExperience } from './HeroExperience';

interface Props {
  pilotUrl: string;
}

const { pilotUrl } = Astro.props;
---

<section class="hero dark-field" id="top" aria-label="Austi introduction">
  <HeroExperience {pilotUrl} client:load />
  <noscript><p class="hero-no-script">Enable JavaScript to try the chat, or <a href={pilotUrl}>talk to us by email</a>.</p></noscript>
  <figure class="hero-scene">
    <picture>
      <source
        srcset="/images/hero-empty-desk-836.webp 836w, /images/hero-empty-desk-1672.webp 1672w"
        sizes="100vw"
        type="image/webp"
      />
      <img
        src="/images/hero-empty-desk.png"
        alt="An empty office chair behind a work table covered in paperwork"
        width="1672"
        height="941"
        fetchpriority="high"
      />
    </picture>
  </figure>
</section>
