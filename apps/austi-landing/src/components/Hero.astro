---
import './Hero.css';

interface Props {
  pilotUrl: string;
}

const { pilotUrl } = Astro.props;
---

<section class="hero dark-field" id="top" aria-label="Austi introduction">
  <div class="hero-intro">
    <h1 class="hero-heading">Your properties<br />maintained. 24/7.</h1>
    <a class="hero-download" href={pilotUrl}>
      <img
        class="hero-download-hdr"
        data-hero-download-hdr
        src="/images/hero-cta-superwhite.avif"
        alt=""
        width="64"
        height="64"
        fetchpriority="high"
        decoding="sync"
        aria-hidden="true"
      />
      <span>Talk to us</span>
      <svg viewBox="0 0 18 18" aria-hidden="true">
        <path d="M3.5 9h11M10 4.5 14.5 9 10 13.5"></path>
      </svg>
    </a>
  </div>
  <figure class="hero-scene">
    <picture>
      <source
        srcset="/images/hero-empty-desk-836.webp 836w, /images/hero-empty-desk-1672.webp 1672w"
        sizes="100vw"
        type="image/webp"
      />
      <img
        src="/images/hero-empty-desk.png"
        alt="An empty office chair behind a work table covered in paperwork"
        width="1672"
        height="941"
        fetchpriority="high"
      />
    </picture>
  </figure>
</section>

<script>
  const hdrImage = document.querySelector<HTMLImageElement>('[data-hero-download-hdr]');

  if (hdrImage) {
    const revealHdr = () => hdrImage.classList.add('is-loaded');

    if (hdrImage.complete) {
      if (hdrImage.naturalWidth > 0) revealHdr();
    } else {
      hdrImage.addEventListener('load', revealHdr, { once: true });
    }
  }
</script>
