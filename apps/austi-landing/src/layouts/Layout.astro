---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site);
const socialImage = new URL('/og.png', site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="color-scheme" content="dark light" />

    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/austi-logo.svg" />
    <link rel="preload" href="/images/hero-cta-superwhite.avif" as="image" type="image/avif" fetchpriority="high" />
    <link rel="preload" href="/fonts/ClarityCity-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ClarityCity-SemiBold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ClarityCity-Bold.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Austi" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Austi — an app that’ll make you question your job" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
  </head>
  <body>
    <!--
      THESIS: Austi makes the absent worker the proof; the opening refuses app chrome, feature tiles, and decorative AI atmosphere.
      OWN-WORLD: The opening is pure black, cold white, monumental phosphor-lit grotesque lettering, and one neutral photographic desk cutout; the existing ruled night-and-paper proof system resumes after the fold.
      STORY: Read Austi, feel the job question, download the preview, encounter the empty desk, then see how durable local software absorbs recurring work.
      FIRST VIEWPORT: A floating white capsule holds the six-dot mark and two links; a centered wordmark, catchphrase, and HDR-white Download action lead to the rear view of an empty chair against a messy desk, all clipped to exactly 100dvh.
      FORM: After-hours Vacancy, user-approved comp hero-centered, seed vacancy-2026-08.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
