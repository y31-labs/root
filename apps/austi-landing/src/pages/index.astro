---
import Closing from '../components/Closing.astro';
import Hero from '../components/Hero.astro';
import Mechanism from '../components/Mechanism.astro';
import Outcome from '../components/Outcome.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';

const title = 'Austi — an app that’ll make you question your job';
const description =
  'Tell Austi what keeps repeating. It builds a private Mac app that takes it from here.';
const downloadUrl = '/download';
---

<Layout {title} {description}>
  <SiteHeader />
  <main id="main-content">
    <Hero {downloadUrl} />
    <Mechanism />
    <Outcome />
    <Closing {downloadUrl} />
  </main>
</Layout>
