---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';

const title = 'Austi — an app that’ll make you question your job';
const description =
  'Tell Austi what keeps repeating. It builds a private Mac app that takes it from here.';
const downloadUrl = 'https://github.com/y31-labs/root/releases';

const launchRows = [
  { task: 'Landing page', owner: 'Maya', initials: 'MM', due: 'May 12', blocker: 'Copy review', status: 'In progress' },
  { task: 'Email campaign', owner: 'Jordan', initials: 'JO', due: 'May 13', blocker: 'Design assets', status: 'In progress' },
  { task: 'Product hunt', owner: 'Alex', initials: 'AK', due: 'May 14', blocker: 'Screenshots', status: 'Planned' },
  { task: 'Launch video', owner: 'Taylor', initials: 'TW', due: 'May 15', blocker: 'Script', status: 'Planned', revisable: true },
  { task: 'Blog post', owner: 'Casey', initials: 'CR', due: 'May 16', blocker: '—', status: 'Planned' },
  { task: 'Analytics setup', owner: 'Riley', initials: 'RS', due: 'May 16', blocker: 'Tracking doc', status: 'Planned' },
];

const stages = [
  { name: 'Ask', label: 'Start with what you want done' },
  { name: 'Build', label: 'Watch the idea find its interface' },
  { name: 'Open', label: 'Skip the recap. Open the app.' },
  { name: 'Keep', label: 'Change it without starting over' },
];
---

<Layout {title} {description}>
  <header class="site-header">
    <a class="header-brand" href="#top" aria-label="Austi home">
      <img src="/austi-logo.svg" alt="" width="22" height="24" />
    </a>
    <nav aria-label="Main navigation">
      <a href="#how-it-works">How it works</a>
    </nav>
  </header>

  <main id="main-content">
    <Hero {downloadUrl} />

    <section class="mechanism paper-field" id="how-it-works" aria-labelledby="mechanism-title">
      <header class="section-heading split-heading">
        <h2 id="mechanism-title">It clocks in where the chat clocks out.</h2>
        <p>Describe the outcome once. Austi turns it into an interface you can open, use, and improve whenever the work returns.</p>
      </header>

      <div class="mechanism-stage" id="mechanism-stage" data-stage="0" data-autoplay="false">
        <nav class="stage-controller" aria-label="Request to app stages">
          {stages.map((item, index) => (
            <button type="button" data-stage-button={index} class:list={{ 'is-active': index === 0 }} aria-pressed={index === 0 ? 'true' : 'false'}>
              <span>{item.name}</span><small>{item.label}</small>
            </button>
          ))}
        </nav>

        <div class="stage-workbench">
          <section class="brief-pane" aria-label="Austi authoring conversation">
            <header><span><span class="brand-mark brand-mark-small"><img src="/austi-logo.svg" alt="" /></span>Austi</span><small id="stage-counter">Ask / 01</small></header>
            <div class="brief-scenes">
              <article class="brief-scene is-active" data-brief-scene="0">
                <h3>Start with what you want done</h3>
                <p>Start with the work, not the wiring.</p>
                <div class="request-card"><span>Build a weekly launch planner that tracks owners, dates, and blockers.</span><i aria-hidden="true"><svg viewBox="0 0 18 18"><path d="M9 14V4m0 0L5 8m4-4 4 4"></path></svg></i></div>
                <small>One request · No template to configure</small>
              </article>
              <article class="brief-scene" data-brief-scene="1" aria-hidden="true">
                <h3>Watch the idea find its interface</h3>
                <p>Structure, state, and controls appear in the open.</p>
                <div class="build-log" aria-label="Illustrative build progress">
                  <span data-build-line="0"><i></i>Understanding the request<small>done</small></span>
                  <span data-build-line="1"><i></i>Designing the data model<small>done</small></span>
                  <span data-build-line="2"><i></i>Building the planner<small>done</small></span>
                  <span data-build-line="3"><i></i>Saving the local app<small>now</small></span>
                </div>
              </article>
              <article class="brief-scene" data-brief-scene="2" aria-hidden="true">
                <h3>Skip the recap. Open the app.</h3>
                <p>Reopen it directly when the work returns.</p>
                <div class="published-row"><span class="app-glyph">L</span><span><strong>Launch planner</strong><small>Published locally · Ready to open</small></span><svg viewBox="0 0 18 18" aria-hidden="true"><path d="M5 13 13 5M7 5h6v6"></path></svg></div>
                <small>Still working long after you stopped prompting.</small>
              </article>
              <article class="brief-scene" data-brief-scene="3" aria-hidden="true">
                <h3>Change it without starting over</h3>
                <p>Revise the app while preserving the work inside it.</p>
                <div class="request-card request-card-small"><span>Move the launch video to Friday. Keep everything else as it is.</span><i aria-hidden="true"><svg viewBox="0 0 18 18"><path d="M9 14V4m0 0L5 8m4-4 4 4"></path></svg></i></div>
                <div class="revision-proof"><i></i><strong>Revision 2 published</strong><span>6 rows preserved</span></div>
              </article>
            </div>
          </section>

          <section class="planner-window stage-window" aria-label="Launch planner transformation preview">
            <header class="window-bar"><div class="traffic-lights" aria-hidden="true"><i></i><i></i><i></i></div><span>Launch planner</span><span class="saved-status"><i></i><span id="stage-app-state">Request ready</span></span></header>
            <div class="planner-main planner-main-compact">
              <header class="planner-heading"><div><span>May 12–18</span><h3>This week</h3></div><span class="compact-add">+ Add item</span></header>
              <div class="launch-table compact-table" role="presentation">
                <div class="launch-head"><span>Item</span><span class="owner">Owner</span><span class="date">Date</span><span>Status</span></div>
                {launchRows.map((row) => (
                  <div class:list={['launch-row', { 'is-revisable': row.revisable }]}>
                    <span class="task">{row.task}</span><span class="owner"><i>{row.initials}</i>{row.owner}</span><span class="date"><span class="due-original">{row.due}</span><span class="due-revised">May 17</span></span><span class="row-status" data-status={row.status.toLowerCase().replace(' ', '-')}><i></i>{row.status}</span>
                  </div>
                ))}
              </div>
              <footer class="planner-footer"><span><svg viewBox="0 0 18 18"><path d="m4 9 3 3 7-7"></path></svg><span id="stage-save-state">Request ready</span></span><span id="stage-revision">Draft</span></footer>
            </div>
            <div class="stage-curtain" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
          </section>
        </div>
        <p class="sr-only" id="stage-announcement" aria-live="polite">Ask Austi for the workflow.</p>
      </div>
    </section>

    <section class="outcome dark-field" aria-labelledby="outcome-title">
      <header class="section-heading outcome-heading">
        <h2 id="outcome-title">Your job, minus the doing-it-again part.</h2>
        <p>The interface fits the workflow, remembers its state, and picks up where you left it. Less prompting. More work already done.</p>
      </header>
      <div class="outcome-stage">
        <p class="campaign-line">Put it in <del>writing</del> <ins>apping.</ins></p>
        <section class="planner-window outcome-window" aria-label="Detailed illustrative Launch planner app">
          <header class="window-bar"><div class="traffic-lights" aria-hidden="true"><i></i><i></i><i></i></div><span>Launch planner</span><span class="saved-status"><i></i> Saved locally</span></header>
          <div class="outcome-appbar"><div><span class="app-glyph">L</span><span><strong>Launch planner</strong><small>Reopened from your Mac</small></span></div><button type="button" tabindex="-1" aria-hidden="true">+ Add item</button></div>
          <div class="outcome-columns">
            <aside><strong>This week</strong><span class="is-active">Launch plan <small>6</small></span><span>Decisions <small>3</small></span><span>Archive <small>12</small></span><p><i></i>Changes saved locally</p></aside>
            <div class="planner-main">
              <header class="planner-heading"><div><span>May 12–18</span><h3>This week</h3></div><span class="week-progress">2 in progress · 4 planned</span></header>
              <div class="launch-table outcome-table" role="table" aria-label="Detailed illustrative launch plan">
                <div class="launch-head" role="row"><span>Item</span><span class="owner">Owner</span><span class="date">Date</span><span class="blocker">Blocker</span><span>Status</span></div>
                {launchRows.map((row) => (
                  <div class="launch-row" role="row"><span class="task" role="cell">{row.task}</span><span class="owner" role="cell"><i>{row.initials}</i>{row.owner}</span><span class="date" role="cell">{row.due}</span><span class="blocker" data-empty={row.blocker === '—'} role="cell">{row.blocker}</span><span class="row-status" data-status={row.status.toLowerCase().replace(' ', '-')} role="cell"><i></i>{row.status}</span></div>
                ))}
              </div>
              <footer class="planner-footer"><span><svg viewBox="0 0 18 18"><path d="m4 9 3 3 7-7"></path></svg>Changes saved locally</span><span>Revision 1 · Current</span></footer>
            </div>
          </div>
        </section>
      </div>
    </section>

    <section class="durability paper-field" aria-labelledby="durability-title">
      <header class="section-heading split-heading">
        <h2 id="durability-title">Gets better without forgetting.</h2>
        <p>Return to the authoring conversation when the workflow changes. Austi publishes a new local revision and preserves the work that still belongs.</p>
      </header>
      <div class="revision-stage" data-revision-state="before">
        <div class="revision-request"><span>One small change</span><blockquote>“Move the launch video to Friday. Keep everything else as it is.”</blockquote><button type="button" data-revision-toggle aria-pressed="false"><span>Publish revision</span><svg viewBox="0 0 18 18" aria-hidden="true"><path d="M9 14V4m0 0L5 8m4-4 4 4"></path></svg></button></div>
        <div class="revision-table">
          <header><span>Launch planner</span><strong id="revision-heading">Revision 1</strong></header>
          <div class="revision-row"><span>Landing page</span><span>May 12</span><span>Preserved</span></div>
          <div class="revision-row"><span>Email campaign</span><span>May 13</span><span>Preserved</span></div>
          <div class="revision-row"><span>Product hunt</span><span>May 14</span><span>Preserved</span></div>
          <div class="revision-row changed-row"><span>Launch video</span><span><del>May 15</del><ins>May 17</ins></span><strong>Changed</strong></div>
          <div class="revision-row"><span>Blog post</span><span>May 16</span><span>Preserved</span></div>
          <div class="revision-row"><span>Analytics setup</span><span>May 16</span><span>Preserved</span></div>
          <footer><span><i></i><strong id="revision-state-label">Ready to publish</strong></span><span>6 rows preserved</span></footer>
        </div>
      </div>
      <p class="campaign-line campaign-line-right">“Not my job,” you say. Finally.</p>
    </section>

    <section class="trust dark-field" id="trust" aria-labelledby="trust-title">
      <header class="section-heading split-heading trust-heading">
        <h2 id="trust-title">Works for you. Answers to your Mac.</h2>
        <p>Austi stores and runs apps locally. Outside access stays narrow, visible, and subject to your approval.</p>
      </header>
      <div class="trust-stage">
        <div class="trust-notes">
          <p><span>01</span><strong>Local ownership</strong>Your app, source, revisions, and working state stay on your Mac.</p>
          <p><span>02</span><strong>Sandboxed execution</strong>The host runs generated software without handing it the keys.</p>
          <p><span>03</span><strong>Explicit outside access</strong>Every consequential action tells you exactly what leaves and where it goes.</p>
        </div>
        <section class="permission-sheet" id="permission-demo" data-permission-state="pending" aria-label="Illustrative permission request">
          <header><span class="app-glyph">L</span><span><small>Illustrative permission request</small><strong>Launch planner</strong><em id="permission-subtitle">is requesting outside access</em></span><span class="permission-status" id="permission-status">One action</span></header>
          <dl>
            <div><dt>Operation</dt><dd>Create one project issue</dd></div>
            <div><dt>Data</dt><dd>Title, owner, due date</dd></div>
            <div><dt>Destination</dt><dd>Product launch project</dd></div>
            <div><dt>Duration</dt><dd>This action only</dd></div>
          </dl>
          <div class="permission-actions"><button type="button" data-permission-action="deny">Keep local</button><button type="button" data-permission-action="allow">Allow this action</button></div>
          <footer><p id="permission-result" aria-live="polite">Nothing leaves your Mac until you choose.</p><button type="button" data-permission-reset hidden>Reset</button></footer>
        </section>
      </div>
    </section>

    <section class="closing paper-field" aria-labelledby="closing-title">
      <div class="closing-copy"><h2 id="closing-title">All done.<br />Go look busy.</h2><p>Build the app only your work could describe. Keep it on the Mac already doing the work.</p></div>
      <div class="closing-action"><a class="button button-primary" href={downloadUrl} target="_blank" rel="noreferrer">Download Austi<svg viewBox="0 0 18 18" aria-hidden="true"><path d="M9 2.5v9m0 0 3.5-3.5M9 11.5 5.5 8M3.5 15h11"></path></svg></a><p>Preview for macOS · Apple silicon</p></div>
      <div class="closing-mark"><span class="brand-mark"><img src="/austi-logo.svg" alt="" /></span><span>Austi</span></div>
    </section>
  </main>

  <footer class="site-footer dark-field">
    <a class="brand" href="#top" aria-label="Back to top"><span class="brand-mark"><img src="/austi-logo.svg" alt="" /></span><span>Austi</span></a>
    <p>It clocks in where the chat clocks out.</p>
    <div><a href="https://github.com/y31-labs/root" target="_blank" rel="noreferrer">GitHub</a><a href="#top">Back to top ↑</a></div>
  </footer>

  <script>
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const stage = document.querySelector<HTMLElement>('#mechanism-stage');
    const stageButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-stage-button]')];
    const scenes = [...document.querySelectorAll<HTMLElement>('[data-brief-scene]')];
    const stageCounter = document.querySelector<HTMLElement>('#stage-counter');
    const stageAppState = document.querySelector<HTMLElement>('#stage-app-state');
    const stageSaveState = document.querySelector<HTMLElement>('#stage-save-state');
    const stageRevision = document.querySelector<HTMLElement>('#stage-revision');
    const stageAnnouncement = document.querySelector<HTMLElement>('#stage-announcement');
    const counters = ['Ask / 01', 'Build / 02', 'Open / 03', 'Keep / 04'];
    const appStates = ['Request ready', 'Building locally', 'Published locally', 'Revision 2'];
    const saveStates = ['Request ready', 'Saving structure', 'Changes saved locally', 'Revision 2 saved locally'];
    const revisionStates = ['Draft', 'Building', 'Ready to reopen', '6 rows preserved'];
    const announcements = [
      'Ask Austi for the workflow.',
      'Austi is building the local app.',
      'The Launch planner is ready to reopen.',
      'Revision 2 preserves the existing planner data.',
    ];
    let currentStage = 0;
    let stageTimer = 0;

    const setStage = (nextStage: number, manual = false) => {
      if (!stage) return;
      currentStage = nextStage;
      stage.dataset.stage = String(nextStage);
      stageButtons.forEach((button, index) => {
        const active = index === nextStage;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });
      scenes.forEach((scene, index) => {
        const active = index === nextStage;
        scene.classList.toggle('is-active', active);
        scene.setAttribute('aria-hidden', String(!active));
      });
      if (stageCounter) stageCounter.textContent = counters[nextStage] ?? '';
      if (stageAppState) stageAppState.textContent = appStates[nextStage] ?? '';
      if (stageSaveState) stageSaveState.textContent = saveStates[nextStage] ?? '';
      if (stageRevision) stageRevision.textContent = revisionStates[nextStage] ?? '';
      if (stageAnnouncement) stageAnnouncement.textContent = announcements[nextStage] ?? '';
      if (manual) {
        window.clearInterval(stageTimer);
        stage.dataset.autoplay = 'false';
      }
    };

    stageButtons.forEach((button, index) => button.addEventListener('click', () => setStage(index, true)));
    setStage(0);
    if (!reducedMotion.matches) {
      stage?.setAttribute('data-autoplay', 'true');
      stageTimer = window.setInterval(() => setStage((currentStage + 1) % stageButtons.length), 5200);
    }

    const revisionStage = document.querySelector<HTMLElement>('.revision-stage');
    const revisionToggle = document.querySelector<HTMLButtonElement>('[data-revision-toggle]');
    const revisionHeading = document.querySelector<HTMLElement>('#revision-heading');
    const revisionStateLabel = document.querySelector<HTMLElement>('#revision-state-label');
    revisionToggle?.addEventListener('click', () => {
      if (!revisionStage || !revisionHeading || !revisionStateLabel) return;
      const revised = revisionStage.dataset.revisionState === 'after';
      revisionStage.dataset.revisionState = revised ? 'before' : 'after';
      revisionToggle.setAttribute('aria-pressed', String(!revised));
      revisionToggle.querySelector('span')!.textContent = revised ? 'Publish revision' : 'Show original';
      revisionHeading.textContent = revised ? 'Revision 1' : 'Revision 2';
      revisionStateLabel.textContent = revised ? 'Ready to publish' : 'Revision 2 published · Ready to reopen';
    });

    const permissionDemo = document.querySelector<HTMLElement>('#permission-demo');
    const permissionActions = [...document.querySelectorAll<HTMLButtonElement>('[data-permission-action]')];
    const permissionReset = document.querySelector<HTMLButtonElement>('[data-permission-reset]');
    const permissionResult = document.querySelector<HTMLElement>('#permission-result');
    const permissionStatus = document.querySelector<HTMLElement>('#permission-status');
    const permissionSubtitle = document.querySelector<HTMLElement>('#permission-subtitle');

    const resetPermission = () => {
      if (!permissionDemo) return;
      permissionDemo.dataset.permissionState = 'pending';
      permissionActions.forEach((button) => (button.disabled = false));
      if (permissionReset) permissionReset.hidden = true;
      if (permissionResult) permissionResult.textContent = 'Nothing leaves your Mac until you choose.';
      if (permissionStatus) permissionStatus.textContent = 'One action';
      if (permissionSubtitle) permissionSubtitle.textContent = 'is requesting outside access';
    };
    permissionActions.forEach((button) => button.addEventListener('click', () => {
      if (!permissionDemo) return;
      const allowed = button.dataset.permissionAction === 'allow';
      permissionDemo.dataset.permissionState = allowed ? 'allowed' : 'denied';
      permissionActions.forEach((action) => (action.disabled = true));
      if (permissionReset) permissionReset.hidden = false;
      if (permissionResult) permissionResult.textContent = allowed
        ? 'Completed once. Access expired after this action.'
        : 'No action was sent. The planner keeps working locally.';
      if (permissionStatus) permissionStatus.textContent = allowed ? 'Completed once' : 'Stayed local';
      if (permissionSubtitle) permissionSubtitle.textContent = allowed ? 'completed the approved action' : 'kept the action on your Mac';
    }));
    permissionReset?.addEventListener('click', resetPermission);
  </script>
</Layout>
