{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@workspace/agent/*": ["src/*"]
    },
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "esnext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
