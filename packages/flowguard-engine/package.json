{
  "name": "@workspace/flowguard-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "bun build src/index.ts --target=node --format=esm --outdir dist",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@workspace/flowguard-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "typescript": "^6.0.3"
  }
}
